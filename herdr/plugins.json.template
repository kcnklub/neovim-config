[
  {
    "plugin_id": "project-picker",
    "name": "Project Picker",
    "version": "0.1.0",
    "min_herdr_version": "0.8.0",
    "description": "Fuzzy-find a project directory and focus or create its workspace",
    "manifest_path": "{{PLUGIN_ROOT}}/herdr-plugin.toml",
    "plugin_root": "{{PLUGIN_ROOT}}",
    "enabled": true,
    "platforms": [
      "linux"
    ],
    "panes": [
      {
        "id": "pick",
        "title": "Open project",
        "placement": "popup",
        "width": "70%",
        "height": "60%",
        "command": [
          "bash",
          "bin/pick"
        ]
      }
    ],
    "source": {
      "kind": "local"
    }
  }
]